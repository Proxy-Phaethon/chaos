register ('everything'):

    state: integer = 42,
    state: decimal = 3.14159,
    state: name = 'Zia',
    state: expression = {x + 1 = 2},

    state: fruits, list = {'apple', 'banana', 'blueberry'},
    state: waiting, queue = {'first', 'second', 'third'},
    state: history, stack = {'older', 'old'},
    state: tree, branch = {'50', '25', '75', '10', '30'};

logic {x > 0};

    constant: x < y;

    list fruits
        (push 'strawberry')
        (push 'raspberry'),

    queue waiting
        (push 'fourth')
        (pop),

    stack history
        (push 'newest')
        (pop),

    branch tree
        (push '60')
        (push '5'),

    transition ('none');

    context {x + 1 = 2},
    rule ('x not equal 0');

execute