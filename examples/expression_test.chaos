register ('expression_test'):
    state: x = 10,
    state: y = 20,

    state: arithmetic = {x + 5 * 2},
    state: parentheses = {(x + 5) * 2},
    state: negative = {-x + 20},

    state: less = {x < y},
    state: greater = {y > x},
    state: less_equal = {x <= 10},
    state: greater_equal = {y >= 20},

    state: equal = {x == 10},
    state: not_equal = {x != y},

    state: arithmetic_comparison = {x + 5 > y},
    state: multiplication_equality = {x * 2 == y},
    state: negative_equality = {-x + 20 == x},
;

execute