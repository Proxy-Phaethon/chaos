register ('minimal'):

    state: x = 1,
    state: empty_list, list = {},
    state: empty_queue, queue = {},
    state: empty_stack, stack = {},
    state: empty_branch, branch = {};

logic {x};

    constant: 1;

    list empty_list (push 'one')
        (pop),
    queue empty_queue (pop),
    stack empty_stack (pop),
    branch empty_branch (push '10');

execute